{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_MIGRATION_URL",
    "API_URL",
    "API_PORT",
    "NODE_ENV"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
