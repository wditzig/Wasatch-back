# Copy to .env for local development. Values below match scripts/db-setup.sh.
# Never commit real secrets. Production values come from the host's secret manager.

# Runtime connection: a NON-owner role that is subject to row-level security.
DATABASE_URL=postgres://municipalos_app:dev_app_password@localhost:5432/municipalos_dev
# Migration connection: the schema owner. Used only by migrate/seed scripts.
DATABASE_MIGRATION_URL=postgres://municipalos_owner:dev_owner_password@localhost:5432/municipalos_dev

TEST_DATABASE_URL=postgres://municipalos_app:dev_app_password@localhost:5432/municipalos_test
TEST_DATABASE_MIGRATION_URL=postgres://municipalos_owner:dev_owner_password@localhost:5432/municipalos_test

API_PORT=4000
# Where the Next.js apps reach the API (server-to-server).
API_URL=http://localhost:4000
SESSION_TTL_HOURS=12
# "console" logs outbound email instead of sending it. No real provider is wired yet.
EMAIL_TRANSPORT=console
