{
  "name": "@municipalos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "reset": "tsx --env-file-if-exists=../../.env src/cli.ts reset"
  },
  "dependencies": {
    "@municipalos/auth": "workspace:*",
    "@municipalos/permissions": "workspace:*",
    "@municipalos/workflows": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
