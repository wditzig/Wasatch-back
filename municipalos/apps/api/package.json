{
  "name": "@municipalos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx src/export-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@municipalos/auth": "workspace:*",
    "@municipalos/database": "workspace:*",
    "@municipalos/notifications": "workspace:*",
    "@municipalos/permissions": "workspace:*",
    "@municipalos/validation": "workspace:*",
    "@municipalos/workflows": "workspace:*",
    "hono": "^4.13.17",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
